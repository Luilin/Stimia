# Supabase — variabili d'ambiente
# Copia questo file in `.env.local` e compila i due valori.
# Li trovi in Supabase → Project Settings → API.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Base path per GitHub Pages (es. /nome-repository/). Lasciare "/" per dominio root.
# VITE_BASE_PATH=/

# Forza la modalità locale (dati solo nel browser) anche con Supabase configurato.
# In sviluppo la modalità locale è già il default; usa `npm run dev:cloud` per
# collegarti a Supabase.
# VITE_LOCAL_MODE=true
